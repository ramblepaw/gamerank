# Copy to .env and fill in. .env is gitignored and must stay that way.
# Docker Compose reads .env automatically from the same directory.

# Cookie signing key. Any random string.
GRT_SECRET=change-me-to-something-random

# IGDB, via Twitch. Create an app at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
